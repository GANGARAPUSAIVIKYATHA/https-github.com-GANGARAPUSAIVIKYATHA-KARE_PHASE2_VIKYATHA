// sum of arrays
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc= new Scanner(System.in);
	    int n= sc.nextInt();
	    int arr[] =new int[n];
	    int i,sum=0;
	    for(i=0;i<n;i++){
	    arr[i]=sc.nextInt();
	    sum=sum+arr[i];
	    }
	    System.out.print("sum of array elements"+sum);
	    
	}
}
