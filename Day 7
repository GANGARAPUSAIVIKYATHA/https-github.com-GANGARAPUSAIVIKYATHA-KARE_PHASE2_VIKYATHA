// count even number odd number and input from the users?
ex :
i/p                   o/p
5
2 3 4 5 6            even count:3
                     odd count:2
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc= new Scanner(System.in);
	    int n= sc.nextInt();
	    int arr[] =new int[n];
	    int i,ec=0,oc=0;
	    for(i=0;i<n;i++){
	    arr[i]=sc.nextInt();
	   
	    if(arr[i]%2==0)
	    ec++;
	    else
	    oc++;
	    }
	    System.out.println(" even count:"+ec);
	    System.out.println("odd count:"+oc);
	}
}
o/p:
5 
2 3 4 6 7
even count:3
odd count:2























