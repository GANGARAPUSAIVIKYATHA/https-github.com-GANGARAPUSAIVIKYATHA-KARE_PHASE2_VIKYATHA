// swapping the numbers
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc= new Scanner(System.in);
	    int n= sc.nextInt();
	    int arr[] =new int[n];
	    int i,temp,s=0,e=n-1;
	    for(i=0;i<n;i++)
	    
	    arr[i]=sc.nextInt();
	    while(s<e){
	        temp=arr[s];
	        arr[s]=arr[e];
	        arr[e]=temp;
	        s++;
	        e--;
	        
	    }
	    for(i=0;i<0;i++)
	       System.out.print(arr[i]+" ");
	    
	}
}


















