import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj =new Scanner(System.in);
        int a =obj.nextInt();
        if(a%2==0)
        System.out.println("Even Number");
        else
        System.out.println("Odd Number");
        
    }
}

