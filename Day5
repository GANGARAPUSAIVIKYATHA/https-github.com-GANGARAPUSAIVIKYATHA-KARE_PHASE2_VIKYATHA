import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner sc= new Scanner(System.in);
        int n= sc.nextInt();
        int i,j;
        for(i=0;i<=4;i++,System.out.println()){
            for(j=0;j<=4;j++){
                if(i==0||i==4||j==0||j==4)
                System.out.print("*");
                else
                System.out.print(" ");
            }
        }
    }
    
}
